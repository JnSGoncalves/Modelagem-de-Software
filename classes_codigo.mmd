---
config:
  layout: elk
---
classDiagram
direction TB
    class Cliente {
	    +String id
	    +String nome
	    +String email
	    +String cpf
	    +Boolean isFidelidade
	    +Date dataNascimento
	    +atualizarDados(nome, email, cpf, dataNascimento)
	    +confirmarEmail(codigo)
	    +solicitarAdesaoFidelidade(dadosCartao)
	    +solicitarReserva(sessao, assentos)
	    +consultarIngressos()
	    +cancelarReserva(ingresso)
	    +solicitarExportacaoIngresso(ingresso)
	    +informarPagamento(dadosCartao)
    }

    class Administrador {
	    +String id
	    +String nome
	    +String email
	    +String cpf
	    +validarCadastro()
	    +solicitarCadastroCinema(cinema)
	    +solicitarCadastroFilme(filme)
	    +solicitarEdicaoFilme(filme)
	    +solicitarRemocaoFilme(filme)
	    +solicitarCadastroSessao(sessao)
	    +solicitarEdicaoSessao(sessao)
	    +solicitarRemocaoSessao(sessao)
	    +configurarMelhoresAssentos(sessao, assentos)
	    +solicitarRelatorioConsolidado(periodo)
    }

    class Cinema {
	    +String id
	    +String nome
	    +String endereco
	    +adicionarSala(sala)
	    +listarSalas()
	    +gerarDadosRelatorio(periodo)
    }

    class Sala {
	    +String id
	    +int numero
	    +int qtd_assentos
        +int fk_cinema
	    +List~int~ melhoresAssentos
	    +adicionarSessao(sessao)
	    +definirMelhoresAssentos(listaAssentos)
	    +verificarDisponibilidade(assento)
        +validarAssento(assento)
    }

    class Sessao {
	    +String id
	    +Date dataHora
	    +double valorInteira
	    +double valorMeia
	    +int ingressosVendidos
	    +double rendaTotal
        +int fk_filme
        +List~int~ assentos_reservados 
	    +calcularValor(tipoIngresso)
        +verificarDisponibilidadeAssento(num_assento)
        +reservarAssentos(assentos)
        +liberarAssentos(assentos)
        +registrarVenda(ingresso)
	    +gerarDadosRelatorio()
    }

    class Filme {
	    +String id
	    +String titulo
	    +int duracao
        +String sinopse
	    +String classificacao
	    +atualizarDados(titulo, duracao, sinopse, classificacao)
	    +remover()
    }

    class Ingresso {
	    +String id
	    +String cpfTitular
	    +String tipo
	    +String status
	    +int numeroAssento
        +int fk_sessao
	    +reservar()
	    +marcarPendenteValidacao()
	    +confirmarPagamento()
	    +cancelar()
	    +gerarArquivo()
    }

    class Validador_de_Documentos {
	    +validarDocumento(documento)
	    +validarDocumentos(documentos)
	    +aprovarDocumento()
	    +rejeitarDocumento()
    }

    class PagamentoAPI {
	    +validarCartao(dadosCartao)
	    +processarPagamento(valor)
	    +confirmarTransacao()
	    +estornarPagamento(valor)
    }

    class AncineAPI {
	    +listarFilmesOficiais()
	    +receberRelatorio(relatorio)
	    +confirmarRecebimento()
    }

    class Relatorio {
	    +String id
	    +Date periodoInicio
	    +Date periodoFim
	    +double rendaTotal
	    +int totalIngressos
		+int totalIngressos_meia_entrada
	    +gerarPorSessao(sessao)
	    +gerarPorFilme(filme)
	    +gerarPorCinema(cinema)
	    +gerarConsolidado(periodoInicio, periodoFim)
	    +exportar()
    }

Cliente "1" -- "0..*" Ingresso : possui

Administrador "1" -- "1..*" Cinema : gerencia

Cinema "1" -- "1..*" Sala : possui
Sala "1" -- "1..*" Sessao : utiliza

Sessao "1" -- "1" Filme : exibe
Sessao "1" -- "0..*" Ingresso : gera

Ingresso "1" -- "1" Cliente : pertence_a
Ingresso "1" -- "1" Sessao : refere_se

Ingresso .. Validador_de_Documentos : valida_documento
Cliente .. PagamentoAPI : realiza_pagamento

Sessao .. AncineAPI : informa_dados
Filme .. AncineAPI : consulta_registro

Cinema .. Relatorio : gera
Filme .. Relatorio : compoe
Sessao .. Relatorio : compoe